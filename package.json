{
  "name": "dsh-purge-compose",
  "version": "0.25.0",
  "description": "复合破甲插件：预设面 + 可测量面（armor 观测 / 载荷仲裁 / 规则审计 / 装配校验 / 破甲率告警 / 双轨判定 / shadow 规则 / 跨卷汇总）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-session-projection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "id": "dsh-purge-compose",
    "name": "破甲复合",
    "version": "0.25.0",
    "permissions": "系统提示词注入（write 模式）, 会话投影（只读观测）, 宿主包只读扫描（compose_audit）",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnx438-hub/dsh-prompt-sections.git"
  },
  "homepage": "https://github.com/johnx438-hub/dsh-prompt-sections#readme",
  "bugs": {
    "url": "https://github.com/johnx438-hub/dsh-prompt-sections/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "system-prompt",
    "sections",
    "observability"
  ]
}
